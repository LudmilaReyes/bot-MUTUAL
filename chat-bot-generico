// Mapeo seguro para el proxy defensivo
const ORIGEN_MEDIOS = {
  '/media/proyecto-a-portada.jpg': 'https://dummyimage.com/600x400/2c3e50/fff&text=Portada+Segura'
};

export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // Endpoint Proxy: Evita exponer URLs finales y fuerza cabeceras seguras
    if (url.pathname.startsWith('/media/')) {
      return handleMediaProxy(url.pathname);
    }

    // Health check para monitoreo
    if (url.pathname === '/' || url.pathname === '') {
      return new Response('🟢 WhatsApp Bot - Worker Online y Operativo', {
        status: 200,
        headers: { 'Content-Type': 'text/plain; charset=utf-8' }
      });
    }

    // Webhooks WhatsApp / Meta
    if (request.method === 'GET') {
      return handleVerify(request, env);
    }
    if (request.method === 'POST') {
      return handleIncoming(request, env, ctx);
    }

    return new Response('Método no permitido', { status: 405 });
  },
};

// ==========================================
// 2. PROXY MULTIMEDIA DEFENSIVO
// ==========================================
async function handleMediaProxy(pathname) {
  const urlOrigen = ORIGEN_MEDIOS[pathname];
  if (!urlOrigen) return new Response('Recurso no configurado', { status: 404 });

  try {
    const respuesta = await fetch(urlOrigen);
    if (!respuesta.ok) return new Response(`Error: ${respuesta.status}`, { status: 502 });

    const headers = new Headers();
    headers.set('Content-Type', 'image/jpeg');
    headers.set('Cache-Control', 'public, max-age=86400');
    headers.set('Access-Control-Allow-Origin', '*');

    return new Response(respuesta.body, { status: 200, headers: headers });
  } catch (error) {
    console.error(`[PROXY ERROR] Fallo al despachar ${pathname}:`, error.message);
    return new Response('Error en proxy', { status: 500 });
  }
}

// ==========================================
// 3. VERIFICACIÓN Y SEGURIDAD (HMAC SHA-256)
// ==========================================
function handleVerify(request, env) {
  const url = new URL(request.url);
  const mode = url.searchParams.get('hub.mode');
  const token = url.searchParams.get('hub.verify_token');
  const challenge = url.searchParams.get('hub.challenge');

  if (mode === 'subscribe' && token === env.VERIFY_TOKEN) {
    return new Response(challenge, { status: 200 });
  }
  return new Response('Error de verificación', { status: 403 });
}

async function verificarFirmaMeta(request, bodyTexto, env) {
  const signature = request.headers.get('X-Hub-Signature-256');
  if (!signature || !env.META_APP_SECRET) return true; // Bypass si no hay secreto en dev

  try {
    const encoder = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
      "raw", encoder.encode(env.META_APP_SECRET), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]
    );
    const signatureBuffer = await crypto.subtle.sign("HMAC", keyMaterial, encoder.encode(bodyTexto));
    const hashHex = Array.from(new Uint8Array(signatureBuffer)).map(b => b.toString(16).padStart(2, '0')).join('');
    
    return signature === `sha256=${hashHex}`;
  } catch (err) {
    console.error("[SECURITY] Error verificando firma:", err);
    return false;
  }
}

// ==========================================
// 4. RECEPCIÓN Y ENRUTAMIENTO OMNICANAL
// ==========================================
async function handleIncoming(request, env, ctx) {
  try {
    const bodyTexto = await request.clone().text();
    const data = JSON.parse(bodyTexto);

    // Flujo A: Respuesta desde Telegram (Operador Humano)
    if (data.update_id) {
      const tokenSecreto = request.headers.get('X-Telegram-Bot-Api-Secret-Token');
      if (env.TELEGRAM_SECRET && tokenSecreto !== env.TELEGRAM_SECRET) {
        return new Response('No autorizado', { status: 401 });
      }
      ctx.waitUntil(procesarMensajeTelegram(data, env));
      return new Response('OK', { status: 200 });
    }

    // Flujo B: Mensaje entrante desde WhatsApp
    const esValido = await verificarFirmaMeta(request, bodyTexto, env);
    if (!esValido) return new Response('Firma inválida', { status: 401 });

    const mensaje = data?.entry?.[0]?.changes?.[0]?.value?.messages?.[0];
    if (!mensaje) return new Response('OK', { status: 200 });

    ctx.waitUntil(procesarMensaje(mensaje, env));
    return new Response('OK', { status: 200 });
  } catch (err) {
    console.error('[FATAL ERROR]:', err);
    return new Response('OK', { status: 200 });
  }
}

// ==========================================
// 5. MÁQUINA DE ESTADOS (STATE MACHINE)
// ==========================================
async function procesarMensaje(mensaje, env) {
  const telefono = mensaje.from;

  try {
    const memoria = await obtenerMemoriaUsuario(telefono, env) || {};
    const estadoActual = memoria.paso || null;
    const textoEscape = mensaje.type === 'text' ? (mensaje.text?.body || '').trim().toLowerCase() : '';

    // Comandos globales de escape
    if (['reset', 'salir', 'menu', 'menú'].includes(textoEscape)) {
      await limpiarMemoria(telefono, env);
      await enviarMenuPrincipal(telefono, env);
      if (estadoActual === 'modo_humano' && memoria.hiloTelegram) {
        await enviarATelegram(`🚨 *El usuario \`${telefono}\` cerró la sesión.*`, memoria.hiloTelegram, env);
        await cerrarHiloTelegram(memoria.hiloTelegram, env);
      }
      return; 
    }

    // Hand-off logic (Derivación Humana activa)
    if (estadoActual === 'modo_humano') {
      if (mensaje.type === 'interactive' && mensaje.interactive?.type === 'list_reply') {
        if (memoria.hiloTelegram) {
          await enviarATelegram(`🔀 *Usuario salió al menú.* Seleccionó: *${mensaje.interactive.list_reply.title}*`, memoria.hiloTelegram, env);
          await cerrarHiloTelegram(memoria.hiloTelegram, env);
        }
        await limpiarMemoria(telefono, env);
        await manejarMenuInteractivo(telefono, mensaje.interactive.list_reply.id, env);
        return;
      }
      const textoUsuario = mensaje.type === 'text' ? mensaje.text.body : '[Archivo recibido]';
      await reenviarMensajeUsuarioATelegram(telefono, textoUsuario, memoria.hiloTelegram, env);
      return;
    }

    // Enrutamiento normal basado en tipo de mensaje
    if (mensaje.type === 'text') {
      await manejarEstadoTexto(telefono, mensaje.text?.body?.trim() || '', estadoActual, memoria, env);
    } else if (mensaje.type === 'interactive' && mensaje.interactive?.type === 'list_reply') {
      await manejarMenuInteractivo(telefono, mensaje.interactive.list_reply.id, env);
    } else {
      await enviarTexto(telefono, '⚠️ Selecciona una opción del menú o escribe *menu* para reiniciar.', env);
    }
  } catch (error) {
    console.error(`[ERROR] Procesando mensaje:`, error);
    await registrarLog(telefono, 'error_sistema', error.message, env);
  }
}

async function manejarEstadoTexto(telefono, textoUsuario, estado, memoria, env) {
  if (!estado) {
    await enviarMenuPrincipal(telefono, env);
    return;
  }

  // Ejemplo de recolección de Leads
  if (estado === 'esperando_nombre_lead') {
    if (textoUsuario.length < 3 || /^[0-9.\s]+$/.test(textoUsuario)) {
      await enviarTexto(telefono, '⚠️ Por favor, ingresa un nombre válido usando letras:', env);
      return;
    }

    const areaInteres = memoria.areaConsulta || 'Consulta General';
    const detalleLead = 
      `👤 *Nuevo Lead:* ${textoUsuario}\n` +
      `🎯 *Interés:* ${areaInteres}\n` +
      `🧭 *Recorrido:* ${memoria.historial?.join(' > ') || 'Directo'}`;

    await derivarAAsesor(telefono, areaInteres, detalleLead, env);
    await registrarLog(telefono, 'lead_capturado', `${areaInteres} - ${textoUsuario}`, env);
  }
}

// ==========================================
// 6. ENRUTADOR DE MENÚS (INTERACTIVE MESSAGING)
// ==========================================
async function manejarMenuInteractivo(telefono, id, env) {
  await registrarLog(telefono, 'seleccion_menu', id, env);

  switch (id) {
    case 'volver_inicio':
      await limpiarMemoria(telefono, env);
      await enviarMenuPrincipal(telefono, env);
      break;

    case 'menu_proyectos':
      await registrarPasoHistorial(telefono, "Vio listado de proyectos", env);
      await enviarMenuLista(
        telefono, "Nuestros Proyectos", "Elige el proyecto que deseas conocer:", "Ver Proyectos 🏘️", "Portafolio Inmobiliario",
        [
          { id: "proyecto_alpha", title: "📍 Proyecto Alpha", description: "Casas y Dúplex Premium" },
          { id: "proyecto_beta", title: "📍 Proyecto Beta", description: "Lotes en barrio privado" },
          { id: "volver_inicio", title: "🔙 Volver al Inicio" }
        ], env
      );
      break;

    // --- FLUJO PROYECTO ALPHA (Casas / PDF / Galerías) ---
    case 'proyecto_alpha':
      await registrarPasoHistorial(telefono, "Exploró Proyecto Alpha", env);
      await enviarImagen(telefono, RECURSOS_PROYECTO_A.portada, "🏢 *Proyecto Alpha*\nOpciones llave en mano con amenidades premium.", env);
      await enviarMenuLista(
        telefono, "Proyecto Alpha", "Explora los detalles:", "Ver Opciones 📋", "Menú Alpha",
        [
          { id: "alpha_modelos", title: "🏡 Modelos Construidos", description: "Ver tipologías de vivienda" },
          { id: "alpha_planos", title: "📄 Planos y Reglamento", description: "Descargar documentación" },
          { id: "alpha_asesor", title: "🙋 Agendar Visita", description: "Hablar con un asesor comercial" },
          { id: "menu_proyectos", title: "🔙 Otros Proyectos" }
        ], env
      );
      break;

    case 'alpha_modelos':
      await enviarTexto(telefono, "🏘️ *Modelo Premium*\nDiseñado para el confort. 3 Habitaciones, 2 baños.", env);
      await enviarImagen(telefono, RECURSOS_PROYECTO_A.modeloImg1, "Exterior Modelo Premium", env);
      await enviarBotonEnlace(telefono, "Ver galería interactiva del proyecto:", "Ver Galería 📸", GALERIA_URL, env);
      break;

    case 'alpha_planos':
      await enviarDocumento(telefono, RECURSOS_PROYECTO_A.reglamentoPdf, "Reglamento_Alpha.pdf", env);
      await enviarImagen(telefono, RECURSOS_PROYECTO_A.planoImg, "Plano de Lotes Alpha", env);
      break;

    // --- FLUJO SOPORTE Y LEAD ---
    case 'alpha_asesor':
    case 'soporte_humano':
      const area = id === 'alpha_asesor' ? 'Ventas Alpha' : 'Soporte General';
      const memoria = await obtenerMemoriaUsuario(telefono, env) || {};
      memoria.paso = 'esperando_nombre_lead';
      memoria.areaConsulta = area;
      await guardarMemoriaUsuario(telefono, memoria, env);
      await enviarTexto(telefono, `👋 Para comunicarte con un asesor de *${area}*, indícanos tu *Nombre y Apellido*:`, env);
      break;

    default:
      await enviarMenuPrincipal(telefono, env);
      break;
  }
}

