// ==========================================
// 7. ADAPTADORES META (WHATSAPP API)
// ==========================================
async function hacerPeticionMeta(payload, env) {
  if (!env.PHONE_NUMBER_ID || !env.META_TOKEN) return false;
  try {
    const res = await fetch(`https://graph.facebook.com/v20.0/${env.PHONE_NUMBER_ID}/messages`, {
      method: 'POST',
      headers: { 'Authorization': `Bearer ${env.META_TOKEN}`, 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    return res.ok;
  } catch (err) {
    console.error("Meta Network Error:", err);
    return false;
  }
}

async function enviarTexto(to, texto, env) {
  return await hacerPeticionMeta({ messaging_product: 'whatsapp', to, type: 'text', text: { body: texto } }, env);
}

async function enviarImagen(to, link, caption, env) {
  return await hacerPeticionMeta({ messaging_product: 'whatsapp', to, type: 'image', image: { link, caption } }, env);
}

async function enviarDocumento(to, link, filename, env) {
  return await hacerPeticionMeta({ messaging_product: 'whatsapp', to, type: 'document', document: { link, filename } }, env);
}

async function enviarBotonEnlace(to, bodyText, buttonText, url, env) {
  return await hacerPeticionMeta({
    messaging_product: "whatsapp", to, type: "interactive",
    interactive: {
      type: "cta_url",
      body: { text: bodyText },
      action: { name: "cta_url", parameters: { display_text: buttonText, url } }
    }
  }, env);
}

async function enviarMenuLista(to, headerText, bodyText, buttonText, sectionTitle, options, env) {
  const rows = options.map(o => ({ id: o.id, title: o.title.slice(0, 24), ...(o.description && { description: o.description.slice(0, 72) }) }));
  return await hacerPeticionMeta({
    messaging_product: "whatsapp", to, type: "interactive",
    interactive: {
      type: "list",
      header: { type: "text", text: headerText },
      body: { text: bodyText },
      action: { button: buttonText.slice(0, 20), sections: [{ title: sectionTitle.slice(0, 24), rows }] }
    }
  }, env);
}

// ==========================================
// 8. OMNICHANNEL TELEGRAM FORUMS INTEGRATION
// ==========================================
async function derivarAAsesor(telefono, area, contexto, env) {
  await enviarTexto(telefono, `Conectando con un agente de *${area}*...`, env);
  
  const threadId = await crearHiloTelegram(`${area} | ${telefono}`, env);
  if (threadId && env.ESTADO_BOT) await env.ESTADO_BOT.put(`tg_thread_${threadId}`, telefono, { expirationTtl: 86400 });
  await guardarMemoriaUsuario(telefono, { paso: 'modo_humano', hiloTelegram: threadId }, env);

  await enviarTexto(telefono, "✅ ¡Listo! Puedes escribir tu consulta aquí.", env);
  await enviarATelegram(`🚨 *NUEVA ATENCIÓN*\n👤 *Tlf:* \`${telefono}\`\n📂 *Área:* ${area}\n\n${contexto}\n\n_Usa /finalizar para cerrar._`, threadId, env);
}

async function crearHiloTelegram(name, env) {
  if (!env.TELEGRAM_TOKEN || !env.TELEGRAM_CHAT_ID) return null;
  try {
    const res = await fetch(`https://api.telegram.org/bot${env.TELEGRAM_TOKEN}/createForumTopic`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: env.TELEGRAM_CHAT_ID, name: name.slice(0, 128) })
    });
    const data = await res.json();
    return data.ok ? data.result.message_thread_id : null;
  } catch (e) { return null; }
}

async function cerrarHiloTelegram(threadId, env) {
  if (!threadId || !env.TELEGRAM_TOKEN || !env.TELEGRAM_CHAT_ID) return;
  fetch(`https://api.telegram.org/bot${env.TELEGRAM_TOKEN}/closeForumTopic`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ chat_id: env.TELEGRAM_CHAT_ID, message_thread_id: threadId })
  }).catch(() => {});
}

async function enviarATelegram(text, threadId, env) {
  if (!env.TELEGRAM_TOKEN || !env.TELEGRAM_CHAT_ID) return null;
  const body = { chat_id: env.TELEGRAM_CHAT_ID, text, parse_mode: 'Markdown', ...(threadId && { message_thread_id: threadId }) };
  return (await fetch(`https://api.telegram.org/bot${env.TELEGRAM_TOKEN}/sendMessage`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
  })).json();
}

async function reenviarMensajeUsuarioATelegram(telefono, texto, threadId, env) {
  const res = await enviarATelegram(`👤 *Mensaje de \`${telefono}\`:*\n\n${texto}`, threadId, env);
  if (res?.result?.message_id && env.ESTADO_BOT) await env.ESTADO_BOT.put(`tg_msg_${res.result.message_id}`, telefono, { expirationTtl: 86400 });
}

async function procesarMensajeTelegram(data, env) {
  const msg = data.message;
  if (!msg?.text || String(msg.chat.id) !== env.TELEGRAM_CHAT_ID) return;

  const threadId = msg.message_thread_id;
  let telefono = (msg.reply_to_message && env.ESTADO_BOT) ? await env.ESTADO_BOT.get(`tg_msg_${msg.reply_to_message.message_id}`) : null;
  if (!telefono && threadId && env.ESTADO_BOT) telefono = await env.ESTADO_BOT.get(`tg_thread_${threadId}`);
  if (!telefono) return;

  if (['/finalizar', '/cerrar'].includes(msg.text.trim().toLowerCase())) {
    await enviarTexto(telefono, "✅ *Atención Finalizada*\nGracias por comunicarte.", env);
    await limpiarMemoria(telefono, env);
    await enviarMenuPrincipal(telefono, env);
    await enviarATelegram("🔒 *Conversación finalizada.*", threadId, env);
    await cerrarHiloTelegram(threadId, env);
    return;
  }
  await enviarTexto(telefono, msg.text, env);
}

// ==========================================
// 9. PERSISTENCIA D1 (SQL) y KV (Key-Value)
// ==========================================
async function registrarPasoHistorial(telefono, accion, env) {
  const memoria = await obtenerMemoriaUsuario(telefono, env) || {};
  memoria.historial = memoria.historial || [];
  if (memoria.historial[memoria.historial.length - 1] !== accion) memoria.historial.push(accion);
  if (memoria.historial.length > 5) memoria.historial.shift(); // Keep last 5 steps
  await guardarMemoriaUsuario(telefono, memoria, env);
}

async function obtenerMemoriaUsuario(telefono, env) {
  try { return env.ESTADO_BOT ? await env.ESTADO_BOT.get(telefono, "json") : null; } catch (e) { return null; }
}

async function guardarMemoriaUsuario(telefono, datos, env) {
  try { if (env.ESTADO_BOT) await env.ESTADO_BOT.put(telefono, JSON.stringify(datos), { expirationTtl: 3600 }); } catch (e) {}
}

async function limpiarMemoria(telefono, env) {
  try { if (env.ESTADO_BOT) await env.ESTADO_BOT.delete(telefono); } catch (e) {}
}

async function registrarLog(telefono, evento, detalle, env) {
  if (!env.DB_LOGS) return; // DB_LOGS is a Cloudflare D1 binding
  try {
    await env.DB_LOGS.prepare("INSERT INTO logs (telefono, evento, detalle) VALUES (?, ?, ?)").bind(telefono, evento, detalle).run();
  } catch (err) {
    console.error('[DB ERROR]:', err.message);
  }
}
